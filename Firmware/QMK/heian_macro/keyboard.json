{
    "manufacturer": "Mina Yeh",
    "keyboard_name": "heian_macro",
    "maintainer": "helan-y",
    "bootloader": "rp2040",
    "diode_direction": "COL2ROW",
    "features": {
        "bootmagic": true,
        "extrakey": true,
        "mousekey": true,
        "nkro": true
    },
    "matrix_pins": {
        "direct": [
            ["GP0"],
            ["GP1"],
            ["GP2"],
            ["GP3"], 
            ["GP4"],
            ["GP5"],
            ["GP6"]
        ]
    },

    "encoder": {
        "rotary": [
            {
                "pin_a": "GP7",
                "pin_b": "GP8",
                "resolution": 2
            },
            {
                "pin_a": "GP9",
                "pin_b": "GP10",
                "resolution": 2
            }
        ]
    },

    "processor": "RP2040",
    "url": "https://github.com/synotonos",
    "usb": {
        "device_version": "1.0.0",
        "pid": "0x0000",
        "vid": "0xFEED"
    },

    "bootmagic": {
        "enabled": false
    },

    "layouts": {
        "LAYOUT": {
            "layout": [
                {"matrix": [0, 0], "x": 1, "y": 1},
                {"matrix": [1, 0], "x": 2, "y": 1},
                {"matrix": [2, 0], "x": 0, "y": 2},
                {"matrix": [3, 0], "x": 1, "y": 0},
                {"matrix": [4, 0], "x": 2, "y": 0},
                {"matrix": [5, 0], "x": 1, "y": 2},
                {"matrix": [6, 0], "x": 2, "y": 2}
            ]
        }
    }
}